layout {

    focus-ring {
        active-color   "#72de58"
        inactive-color "#0f150c"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#72de58"
        inactive-color "#0f150c"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#72de58"
        inactive-color "#39a625"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#72de5880"
    }
}

recent-windows {
    highlight {
        active-color "#72de58"
        urgent-color "#ffb4ab"
    }
}
